+    function composerTextarea(node) {
+      const textarea = node?.closest?.('[data-composer-seat]')?.querySelector('textarea')
+      return textarea instanceof HTMLTextAreaElement ? textarea : null
+    }
+
+    function firstFileOffset(input) {
+      let offset
+      for (const occurrence of input?.occurrences || []) {
+        if (occurrence.source !== SOURCE) continue
+        if (offset === undefined || occurrence.offset < offset) offset = occurrence.offset
+      }
+      return offset
+    }
+
+    function keepSelectionBeforeFiles(textarea, input) {
+      const boundary = firstFileOffset(input)
+      if (boundary === undefined) return
+      const start = textarea.selectionStart ?? boundary
+      const end = textarea.selectionEnd ?? start
+      if (start <= boundary && end <= boundary) return
+      textarea.setSelectionRange(
+        Math.min(start, boundary),
+        Math.min(end, boundary),
+        textarea.selectionDirection || 'none',
+      )
+    }
