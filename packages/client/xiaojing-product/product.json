{
  "schemaVersion": 1,
  "product": "xiaojing-accounting",
  "upstream": {
    "remote": "https://github.com/deepseek-ai/deepseek-harness.git",
    "release": "dsh-v0.2.0-rc.2"
  },
  "integrationBase": "xiaojing-history-20260930-4",
  "slots": [
    "sidebar.brand.mark",
    "sidebar.brand.name",
    "conversation.hero.brand.mark",
    "conversation.hero.brand.content",
    "conversation.hero.context",
    "conversation.chat.node",
    "onboarding.content",
    "settings.section"
  ],
  "agentPresets": [
    {
      "id": "finance",
      "name": "Finance模式",
      "base": "standard",
      "composition": "apps/cli/config/xiaojing-agent-presets/finance/agent.cordis.yml"
    }
  ],
  "financeExtension": {
    "schemaVersion": 1,
    "presetRoot": "apps/cli/config/xiaojing-agent-presets",
    "durableRoot": "harness/finance",
    "compatibilityAdapter": "src/compat.ts",
    "skills": [
      {
        "name": "finance-tax-research-cn",
        "path": "apps/cli/config/xiaojing-agent-presets/finance/skills/finance-tax-research-cn/SKILL.md"
      },
      {
        "name": "finance-document-reading",
        "path": "apps/cli/config/xiaojing-agent-presets/finance/skills/finance-document-reading/SKILL.md"
      },
      {
        "name": "finance-invoice-review",
        "path": "apps/cli/config/xiaojing-agent-presets/finance/skills/finance-invoice-review/SKILL.md"
      },
      {
        "name": "finance-voucher-draft",
        "path": "apps/cli/config/xiaojing-agent-presets/finance/skills/finance-voucher-draft/SKILL.md"
      },
      {
        "name": "finance-data-analysis",
        "path": "apps/cli/config/xiaojing-agent-presets/finance/skills/finance-data-analysis/SKILL.md"
      }
    ],
    "host": {
      "directory": "packages/xiaojing",
      "packagePrefix": "@deepseek-ai/dsh-xiaojing-finance-",
      "rowPrefix": "xiaojing-finance-",
      "packages": [
        {
          "name": "@deepseek-ai/dsh-xiaojing-finance-calculations",
          "row": "xiaojing-finance-calculations",
          "compatibilityAdapter": true
        },
        {
          "name": "@deepseek-ai/dsh-xiaojing-finance-domain",
          "row": "xiaojing-finance-domain",
          "compatibilityAdapter": true
        },
        {
          "name": "@deepseek-ai/dsh-xiaojing-finance-documents",
          "row": "xiaojing-finance-documents",
          "compatibilityAdapter": true
        },
        {
          "name": "@deepseek-ai/dsh-xiaojing-finance-evidence",
          "row": "xiaojing-finance-evidence",
          "compatibilityAdapter": true
        }
      ]
    },
    "client": {
      "directory": "packages/client",
      "packagePrefix": "@deepseek-ai/dsh-client-ui-xiaojing-finance-",
      "rowPrefix": "ui-xiaojing-finance-",
      "packages": [
        {
          "name": "@deepseek-ai/dsh-client-ui-xiaojing-finance-clients",
          "row": "ui-xiaojing-finance-clients",
          "compatibilityAdapter": false
        }
      ]
    }
  },
  "assets": [
    "apps/web/public/sdoobot-avatar.png",
    "apps/web/public/xiaojing-robot-logo.png",
    "apps/web/public/xiaojing-character-logo.png",
    "apps/web/public/xiaojing-office-robot-logo.png",
    "apps/web/public/xiaojing-finance-robot-logo.png",
    "apps/web/public/sudo-logo-gray.png",
    "apps/web/public/youcheng-finance-logo.png",
    "apps/web/public/desktop-companion/idle.webp"
  ],
  "desktopManifests": [
    "apps/desktop/identity.json",
    "apps/desktop/integration-patches.json",
    "apps/desktop/user-data-contract.json"
  ],
  "featurePackages": [
    "@deepseek-ai/dsh-xiaojing-browser-control",
    "@deepseek-ai/dsh-xiaojing-computer-control",
    "@deepseek-ai/dsh-xiaojing-desktop-companion",
    "@deepseek-ai/dsh-xiaojing-weixin-channel",
    "@deepseek-ai/dsh-xiaojing-visualize",
    "@deepseek-ai/dsh-client-ui-weixin-channel",
    "@deepseek-ai/dsh-client-ui-desktop-companion",
    "@deepseek-ai/dsh-client-ui-xiaojing-browser-control"
  ]
}
