{
  "name": "@deepseek-ai/dsh-xiaojing-finance-documents",
  "description": "Shared deterministic local document normalization for Xiaojing sessions",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/xiaojing/xiaojing-finance-documents"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/types/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./general-tool": {
      "types": "./lib/types/general-tool.d.ts",
      "default": "./lib/general-tool.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/parser-worker.js",
    "lib/tool.js",
    "lib/general-tool.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@napi-rs/canvas": "1.0.2",
    "csv-parse": "^7.0.2",
    "fast-xml-parser": "^5.7.3",
    "fast-xml-validator": "^1.4.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.1",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.3",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-xiaojing-finance-domain": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-xiaojing-finance-domain": "workspace:*",
    "tsx": "^4.22.4"
  }
}
