{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "小兢会计 Windows desktop application",
  "version": "0.1.7-rc.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "author": {
    "name": "瑞华云数豆科技"
  },
  "scripts": {
    "test:installer": "node scripts/test-windows-installer.mjs",
    "build": "tsc -b && tsdown",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "test:updates:local": "pnpm run build && node scripts/test-local-updater.mjs",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "prepare:primary-runtime": "tsx scripts/prepare-primary-runtime.ts",
    "sign:primary-runtime": "tsx scripts/sign-primary-runtime.ts",
    "cache:windows-signatures": "node scripts/manage-windows-signature-cache.mjs",
    "prepare:packages": "tsx scripts/prepare-package-set.ts",
    "prepare:dsh": "tsx scripts/prepare-dsh.ts",
    "prepare:package": "tsx scripts/package-target.ts --prepare-only",
    "verify:mac-signature": "node scripts/verify-macos-signature.mjs",
    "package": "tsx scripts/package-target.ts",
    "check:package": "tsx scripts/package-target.ts --check",
    "restore:mac-proxy": "tsx scripts/macos-notarization-proxy.ts",
    "package:dir": "tsx scripts/package-target.ts --dir",
    "package:mac:arm64": "tsx scripts/package-target.ts mac-arm64",
    "package:mac:arm64:dir": "tsx scripts/package-target.ts mac-arm64 --dir",
    "package:mac:x64": "tsx scripts/package-target.ts mac-x64",
    "package:mac:x64:dir": "tsx scripts/package-target.ts mac-x64 --dir",
    "package:win:x64": "pnpm run prepare:icons && pnpm run verify:xiaojing && tsx scripts/package-target.ts win-x64",
    "package:win:x64:unsigned": "pnpm run prepare:icons && pnpm run verify:xiaojing && tsx scripts/package-target.ts win-x64 --unsigned",
    "package:win:x64:dir": "pnpm run prepare:icons && pnpm run verify:xiaojing && tsx scripts/package-target.ts win-x64 --dir",
    "upload:mac:arm64": "tsx scripts/upload-target.ts mac-arm64",
    "upload:mac:x64": "tsx scripts/upload-target.ts mac-x64",
    "upload:win:x64": "tsx scripts/upload-target.ts win-x64",
    "prepare:icons": "node scripts/prepare-installer-icon.mjs",
    "verify:installer-shortcuts": "node scripts/verify-installer-shortcuts.mjs",
    "verify:installer-cancel": "node scripts/verify-installer-cancel-helper.mjs",
    "verify:installer-shutdown": "node scripts/verify-installer-shutdown-helper.mjs",
    "verify:identity": "node scripts/verify-desktop-identity.mjs",
    "verify:product-layer": "node ../../scripts/verify-xiaojing-product-layer.mjs",
    "verify:user-data": "node scripts/verify-user-data-contract.mjs",
    "verify:xiaojing": "pnpm run verify:identity && pnpm run verify:installer-shortcuts && pnpm run verify:installer-cancel && pnpm run verify:installer-shutdown && pnpm run verify:user-data && pnpm run verify:product-layer",
    "dist:win": "pnpm run package:win:x64"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-credentials-local": "workspace:*",
    "@deepseek-ai/dsh-deepseek-account": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@deepseek-ai/dsh-usage-accounting": "workspace:*",
    "@deepseek-ai/dsh-xiaojing-finance-domain": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@electron/get": "^5.1.0",
    "@electron/notarize": "2.5.0",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "app-builder-lib": "26.15.3",
    "cos-nodejs-sdk-v5": "3.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.2.0",
    "koffi": "^3.1.0",
    "pnpm": "11.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
