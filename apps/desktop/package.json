  "build": {
    "appId": "com.sudotech.xiaojing-accounting",
    "productName": "小兢会计-您的AI办公搭子",
    "copyright": "Copyright © 2026 瑞华云数豆科技",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "dist/installer"
    },
    "files": [
      "main.mjs",
      "identity.json",
      "integration-patches.json",
      "user-data-contract.json",
      "loading.html",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/node.exe",
        "to": "runtime/node.exe"
      },
      {
        "from": "../../LICENSE",
        "to": "legal/DeepSeek-Harness-LICENSE.txt"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/app-icon.png",
      "executableName": "小兢会计",
      "legalTrademarks": "小兢会计是瑞华云数豆科技内部使用品牌"
    },
    "nsis": {
      "guid": "1f6e3c2a-13e7-5ab1-a2d7-10b68c1b911a",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "小兢会计",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "artifactName": "小兢会计-您的AI办公搭子-${version}-安装程序.${ext}"
    }
